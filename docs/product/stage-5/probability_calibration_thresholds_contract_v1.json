  "role_reuse_policy": {
    "hyperparameter_selection_source": "Generate six early target months C-17..C-12 using each unchanged Stage4 grid configuration; model/preparer fit through C-17-h. Only these labels select configuration.",
    "development_predictions_source": "One selected model/preparer fitted through C-12 supplies all later calibration/threshold roles, without using any of their labels. Save all internal model states and keyed predictions.",
    "outer_model_refit_policy": "Refit selected configuration once through external cutoff C; retain earlier calibrator and threshold unchanged. Availability includes all fitted/selected dependencies. Distribution transfer to this refit is a limitation, not recalibration on external outcomes.",
    "calibrator_refit_policy": "Fit sigmoid calibrator per candidate/window/horizon using only calibration_fit role rows when both classes exist.",
    "threshold_refit_policy": "Select threshold per candidate/window/horizon from threshold_selection role rows; no cross-window reuse."
  },
  "support_requirements": {
    "min_hyperparameter_selection_months": 5,
    "min_calibration_fit_months": 2,
    "min_calibration_selection_months": 2,
    "min_threshold_selection_months": 1
  },
  "execution_budget": {
    "max_outer_model_refits": 24,
    "max_sigmoid_fits": 24,
    "notes": "112 fixed-grid early-selection fits +24 selected internal fits +24 outer fits; at most24 sigmoid fits. No expanded grids. Entire calendar/class/population preflight before fitting.",
    "max_hyperparameter_model_fits": 112,
    "max_internal_model_refits": 24,
    "max_total_model_fits": 160,
    "max_total_fits": 184
  },
  "calibration_policy": {
    "method": "sigmoid",
    "alternatives": [
      "original",
      "sigmoid"
    ],
    "curve_bins": 10,
    "min_bin_support": 30,
    "min_supported_bins": 2,
    "brier_tolerance": 1e-12,
    "calibration_gap_tolerance": 1e-06,
    "acceptance_rule": "Select sigmoid only if development-selection Brier improves beyond tolerance, or if Brier ties and weighted supported calibration gap improves beyond tolerance. Otherwise keep original probabilities."
  },
  "threshold_policy": {
    "shared_across_municipalities": true,
    "candidate_grid": "unique_selected_probabilities_plus_bounds",
    "probability_precision": 12,
    "objective": "Maximize onset_sensitivity under false_alarm constraint; ties by fewer false alerts, then lower false_alarm_ratio, then higher threshold.",
    "no_artificial_gain": "Do not tune threshold to force minimum onset gain. Report unmet gain explicitly."
  },
  "artifacts": {
    "base_dir": "artifacts/model_evaluation",
    "notebook_receipts_dir": "artifacts/model_evaluation/notebook_execution",
    "existing_policy": "reuse_identical",
    "save_development_predictions": true,
    "save_posterior_predictions": true,
    "save_temporal_audit": true,
    "save_selection_evidence": true,
    "save_manifest_provenance": true
  },
